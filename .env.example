# ==============================================================================
# AEGIS SECURITY — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Never commit real secrets to version control.
# Configure these variables in your hosting environment / AI Studio Secrets / Pterodactyl.

NODE_ENV=development
PORT=3000

# Hosting & Application URLs
APP_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000

# Discord Application & OAuth2 (Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
DISCORD_BOT_TOKEN=
DISCORD_BOT_INVITE_URL=

# Persistence & Distributed Cache (Optional in single-node sandbox; required for multi-container production)
MONGODB_URI=
REDIS_URL=

# Distributed Gateway & Container Isolation
# Bot container: AEGIS_STANDALONE_BOT=true | Web/API container: AEGIS_EMBEDDED_BOT=false
AEGIS_STANDALONE_BOT=false
AEGIS_EMBEDDED_BOT=false
AEGIS_REQUIRE_DISTRIBUTED_LOCK=false
AEGIS_LOCAL_SINGLE_INSTANCE=true
DISCORD_ENABLE_MESSAGE_CONTENT=false
DISCORD_SHARD_COUNT=auto
WORKER_MAX_CONCURRENCY=4
WORKER_INTERVAL_MS=60000

# Security & Session Signing (Generate 32+ byte cryptographically random strings)
SESSION_SECRET=
ENCRYPTION_KEY=

# Initial Platform Governance (Comma-separated Discord User IDs)
OWNER_IDS=1052422681569525792
GLOBAL_ADMIN_IDS=

# Logging & Diagnostics
LOG_LEVEL=info
